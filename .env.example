# Opriva Environment Configuration Template
# Copy this file to .env or set environment variables in your deployment environment (Docker / Azure / Neon / Vercel)

# ========================================================
# SERVER CONFIGURATION
# ========================================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ========================================================
# DATABASE CONFIGURATION (PostgreSQL / Neon)
# ========================================================
# In dev profile, in-memory PostgreSQL-compatible H2 is enabled for instant testing.
# For production (prod profile), provide Neon / Azure PostgreSQL credentials:
DB_URL=jdbc:postgresql://ep-example-pooler.ap-southeast-1.aws.neon.tech/oprivadb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_db_password_here
DB_POOL_SIZE=10
DB_MIN_IDLE=3

# ========================================================
# JWT & SECURITY
# ========================================================
# 256-bit secret key for HMAC-SHA256 signing
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ========================================================
# GOOGLE PLACES API (Hospital Discovery & Genuine Ratings)
# ========================================================
# When left empty, Opriva automatically switches to MockPlacesAdapter (with clearly tagged mock indicators)
GOOGLE_PLACES_API_KEY=AIzaSyYourGooglePlacesApiKeyHere

# ========================================================
# RAZORPAY PAYMENT GATEWAY (Indian Rupee INR)
# ========================================================
# When left empty, Opriva automatically switches to MockDevelopmentPaymentGateway
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere

# ========================================================
# DOCUMENT STORAGE (Azure Blob Storage / Local Storage)
# ========================================================
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads/medical-documents
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=oprivastore;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=opriva-documents

# ========================================================
# FIREBASE CLOUD MESSAGING (Mobile Push Notifications)
# ========================================================
FCM_SERVICE_ACCOUNT_JSON=./config/firebase-service-account.json

# ========================================================
# WEB CLIENT CONFIGURATION
# ========================================================
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws
